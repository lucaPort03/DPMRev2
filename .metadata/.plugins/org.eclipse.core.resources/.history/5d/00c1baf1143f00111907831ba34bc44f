#pragma pack(push, 1)
typedef struct {
    uint8_t  magic[2];            /* 0xAA, 0xBB                        */
    uint16_t seq;                 /* packet counter                    */
    uint32_t timestamp_ms;        /* HAL_GetTick()                     */

    /* Raw hardware registers */
    uint16_t ldc[32];             /* L-data period register            */
    uint16_t rp[32];              /* RP resistance register            */

    /* Computed values — all filled by build_ldc_packet() */
    uint32_t freq_hz[32];         /* resonant frequency (Hz)           */
    int32_t  deviation[32];       /* band-pass filter output           */
    int32_t  threshold[32];       /* frozen detection threshold        */
    int32_t  baseline[32];        /* frozen baseline frequency         */
//    int32_t  threshold_freq[32];  /* baseline + threshold (absolute Hz)*/
    int32_t  raw_mean[32];        /* Welford mean of raw frequency     */
    int32_t  filt_std[32];        /* Welford std-dev of filtered signal*/
    uint8_t  is_metal[32];        /* 1 = metal detected, 0 = clear     */
    uint8_t  calib_done[32];      /* 1 = calibration complete          */
} AMCISS_Packet_t;
/* sizeof = 2+2+4 + 32*2 + 32*2 + 32*4*7 + 32 + 32
         = 8 + 64 + 64 + 896 + 32 + 32 = 1096 bytes                     */
#pragma pack(pop)
/* USER CODE END PTD */

