/* ================================================================
 *  MX_NetXDuo_Init  — unchanged from previous version
 * ================================================================ */
UINT MX_NetXDuo_Init(VOID *memory_ptr)
{
    UINT ret = NX_SUCCESS;
    TX_BYTE_POOL *byte_pool = (TX_BYTE_POOL *)memory_ptr;
    CHAR *pointer;

    printf("Nx_UDP_Echo_Client application started..\n");
    nx_system_initialize();

    if (tx_byte_allocate(byte_pool, (VOID **)&pointer, NX_APP_PACKET_POOL_SIZE, TX_NO_WAIT) != TX_SUCCESS)
        return TX_POOL_ERROR;

    ret = nx_packet_pool_create(&NxAppPool, "NetXDuo App Pool", DEFAULT_PAYLOAD_SIZE,
                                pointer, NX_APP_PACKET_POOL_SIZE);
    if (ret != NX_SUCCESS) return NX_POOL_ERROR;

    if (tx_byte_allocate(byte_pool, (VOID **)&pointer, Nx_IP_INSTANCE_THREAD_SIZE, TX_NO_WAIT) != TX_SUCCESS)
        return TX_POOL_ERROR;

    ret = nx_ip_create(&NetXDuoEthIpInstance, "NetX Ip instance",
                       NX_APP_DEFAULT_IP_ADDRESS, NX_APP_DEFAULT_NET_MASK,
                       &NxAppPool, nx_stm32_eth_driver,
                       pointer, Nx_IP_INSTANCE_THREAD_SIZE, NX_APP_INSTANCE_PRIORITY);
    if (ret != NX_SUCCESS) return NX_NOT_SUCCESSFUL;

    if (tx_byte_allocate(byte_pool, (VOID **)&pointer, DEFAULT_ARP_CACHE_SIZE, TX_NO_WAIT) != TX_SUCCESS)
        return TX_POOL_ERROR;

    ret = nx_arp_enable(&NetXDuoEthIpInstance, (VOID *)pointer, DEFAULT_ARP_CACHE_SIZE);
    if (ret != NX_SUCCESS) return NX_NOT_SUCCESSFUL;

    ret = nx_icmp_enable(&NetXDuoEthIpInstance);
    if (ret != NX_SUCCESS) return NX_NOT_SUCCESSFUL;

    if (CLIENT == 1)
    {
        if (tx_byte_allocate(byte_pool, (VOID **)&pointer, NX_APP_THREAD_STACK_SIZE, TX_NO_WAIT) != TX_SUCCESS)
            return TX_POOL_ERROR;

        ret = tx_thread_create(&AppUDPThread, "App UDP Thread", App_UDP_Thread_Entry, 0,
                               pointer, NX_APP_THREAD_STACK_SIZE,
                               NX_APP_THREAD_PRIORITY, NX_APP_THREAD_PRIORITY,
                               10, TX_DONT_START);
    }
    else
    {
        if (tx_byte_allocate(byte_pool, (VOID **)&pointer, 6 * DEFAULT_ARP_CACHE_SIZE, TX_NO_WAIT) != TX_SUCCESS)
            return TX_POOL_ERROR;

        ret = tx_thread_create(&AppUDPThread, "App UDP Server Thread", App_UDP_Server_Thread_Entry, 0,
                               pointer, 6 * 1024,
                               NX_APP_THREAD_PRIORITY, NX_APP_THREAD_PRIORITY,
                               TX_NO_TIME_SLICE, TX_DONT_START);
    }
    if (ret != TX_SUCCESS) return NX_NOT_SUCCESSFUL;

    ret = nx_tcp_enable(&NetXDuoEthIpInstance);
    if (ret != NX_SUCCESS) return NX_NOT_SUCCESSFUL;

    ret = nx_udp_enable(&NetXDuoEthIpInstance);
    if (ret != NX_SUCCESS) return NX_NOT_SUCCESSFUL;

    if (tx_byte_allocate(byte_pool, (VOID **)&pointer, NX_APP_THREAD_STACK_SIZE, TX_NO_WAIT) != TX_SUCCESS)
        return TX_POOL_ERROR;

    ret = tx_thread_create(&NxAppThread, "NetXDuo App thread", nx_app_thread_entry, 0,
                           pointer, NX_APP_THREAD_STACK_SIZE,
                           NX_APP_THREAD_PRIORITY, NX_APP_THREAD_PRIORITY,
                           TX_NO_TIME_SLICE, TX_AUTO_START);
    if (ret != TX_SUCCESS) return TX_THREAD_ERROR;

    if (tx_byte_allocate(byte_pool, (VOID **)&pointer, NX_APP_THREAD_STACK_SIZE, TX_NO_WAIT) != TX_SUCCESS)
        return TX_POOL_ERROR;

    ret = tx_thread_create(&AppLinkThread, "App Link Thread", App_Link_Thread_Entry, 0,
                           pointer, NX_APP_THREAD_STACK_SIZE,
                           LINK_PRIORITY, LINK_PRIORITY, TX_NO_TIME_SLICE, TX_AUTO_START);
    if (ret != TX_SUCCESS) return NX_NOT_ENABLED;

    return ret;
}

static VOID ip_address_change_notify_callback(NX_IP *ip_instance, VOID *ptr)
{
    nx_ip_address_set(&NetXDuoEthIpInstance, STM_IP_ADDRESS, STM_NETMASK);
    nx_ip_gateway_address_set(&NetXDuoEthIpInstance, STM_GATEWAY);
    tx_thread_resume(&AppUDPThread);
}

static VOID nx_app_thread_entry(ULONG thread_input)
{
    UINT ret;
    ULONG actual_status;

    nx_ip_address_set(&NetXDuoEthIpInstance, STM_IP_ADDRESS, STM_NETMASK);
    nx_ip_gateway_address_set(&NetXDuoEthIpInstance, STM_GATEWAY);
    printf("Static IP set\n");

    ret = nx_ip_interface_status_check(&NetXDuoEthIpInstance, 0,
                                       NX_IP_LINK_ENABLED, &actual_status, NX_WAIT_FOREVER);
    if (ret != NX_SUCCESS) { printf("Link down\n"); Error_Handler(); }

    printf("Link up - starting UDP server\n");
    tx_thread_resume(&AppUDPThread);

    nx_ip_address_change_notify(&NetXDuoEthIpInstance,
                                ip_address_change_notify_callback, NULL);
}

