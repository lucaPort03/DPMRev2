/* ================================================================
 *  App_Sensor_Thread_Entry  —  NEW HIGH-PRIORITY THREAD
 *
 *  Runs as fast as the SPI bus allows.
 *  Never calls any blocking network function.
 *
 *  For each sensor every iteration:
 *    1. Read LDC + RP registers via SPI burst
 *    2. Compute frequency
 *    3. Run Detector_Update
 *    4. Write results to sensorResults[]
 *    5. SET is_metal_latch if metal detected — NEVER clears it
 *       (the UDP thread clears it after reading)
 * ================================================================ */
static VOID App_Sensor_Thread_Entry(ULONG thread_input)
{
    int      i;
    uint8_t  buf[4];
    double   f_clkin = 16000000.0;

    /* Initialise all detectors */
    for (i = 0; i < LDC1101_SENSOR_COUNT; i++) {
        Detector_Init(&myDetector[i]);
        sensorResults[i].is_metal_latch = 0u;
        sensorResults[i].is_metal_now   = 0u;
    }

    while (1)
    {
        for (i = 0; i < LDC1101_SENSOR_COUNT; i++)
        {
            /* 1. Read hardware registers */
            hal_gpio_csSelect(i);
            ldc1101_read_extendedN(0x21, buf, 4);
            hal_gpio_csRelease(i);

            uint16_t rp  = (uint16_t)((buf[1] << 8) | buf[0]);
            uint16_t ldc = (uint16_t)((buf[3] << 8) | buf[2]);

            /* 2. Compute frequency */
            uint32_t freq_hz = (ldc > 0u)
                               ? (uint32_t)((f_clkin * 384.0) / (3.0 * (double)ldc))
                               : 0u;

            /* 3. Run detection */
            bool metal = Detector_Update(&myDetector[i], (double)freq_hz);

            /* 4. Write results atomically (32-bit aligned writes on M7) */
            sensorResults[i].ldc       = ldc;
            sensorResults[i].rp        = rp;
            sensorResults[i].freq_hz   = freq_hz;
            sensorResults[i].deviation = (int32_t)myDetector[i].deviation;
            sensorResults[i].threshold = (int32_t)myDetector[i].threshold;
            sensorResults[i].baseline  = (int32_t)myDetector[i].baseline;
            sensorResults[i].raw_mean  = (int32_t)myDetector[i].raw_mean;
            sensorResults[i].filt_std  = (int32_t)myDetector[i].filt_std;
            sensorResults[i].calib_done = myDetector[i].calib_done ? 1u : 0u;
            sensorResults[i].is_metal_now = metal ? 1u : 0u;

            /* 5. LATCH: set if metal detected, NEVER clear here.
             *    The UDP thread is the only one that clears this.
             *    This guarantees no detection event is ever lost. */
            if (metal) {
                sensorResults[i].is_metal_latch = 1u;
            }
        }
        /* No sleep, no relinquish — run as fast as SPI allows.
         * The higher priority ensures network calls never starve us. */
    }
}

/* ================================================================
 *  App_UDP_Thread_Entry
 *
 *  Reads from sensorResults[], builds the packet, sends over UDP.
 *  Clears is_metal_latch AFTER reading it into the packet so the
 *  sensor thread can set it again immediately.
 * ================================================================ */
static VOID App_UDP_Thread_Entry(ULONG thread_input)
{
    UINT            ret;
    NX_PACKET      *data_packet;
    static uint16_t seq = 0;
    int             i;

    ret = nx_udp_socket_create(&NetXDuoEthIpInstance, &UDPSocket,
                               "UDP Client Socket", NX_IP_NORMAL,
                               NX_FRAGMENT_OKAY, NX_IP_TIME_TO_LIVE, 200);
    if (ret != NX_SUCCESS) Error_Handler();

    ret = nx_udp_socket_bind(&UDPSocket, DEFAULT_PORT, NX_WAIT_FOREVER);
    if (ret != NX_SUCCESS) Error_Handler();

    while (1)
    {
        /* Build packet from latched sensor results */
        AMCISS_Packet_t pkt;
        pkt.magic[0]     = 0xAAu;
        pkt.magic[1]     = 0xBBu;
        pkt.seq          = seq++;
        pkt.timestamp_ms = HAL_GetTick();

        for (i = 0; i < LDC1101_SENSOR_COUNT; i++)
        {
            pkt.ldc      [i] = sensorResults[i].ldc;
            pkt.rp       [i] = sensorResults[i].rp;
            pkt.freq_hz  [i] = sensorResults[i].freq_hz;
            pkt.deviation[i] = sensorResults[i].deviation;
            pkt.threshold[i] = sensorResults[i].threshold;
            pkt.baseline [i] = sensorResults[i].baseline;
            pkt.raw_mean [i] = sensorResults[i].raw_mean;
            pkt.filt_std [i] = sensorResults[i].filt_std;
            pkt.calib_done[i]= sensorResults[i].calib_done;

            /* Read latch THEN clear it.
             * If sensor thread sets it again between these two lines,
             * the value will be 1 in the NEXT packet — nothing is lost. */
            pkt.is_metal[i] = sensorResults[i].is_metal_latch;
            sensorResults[i].is_metal_latch = 0u;
        }

        ret = nx_packet_allocate(&NxAppPool, &data_packet, NX_UDP_PACKET, TX_WAIT_FOREVER);
        if (ret != NX_SUCCESS) continue;

        ret = nx_packet_data_append(data_packet, (VOID *)&pkt, sizeof(AMCISS_Packet_t),
                                    &NxAppPool, TX_WAIT_FOREVER);
        if (ret != NX_SUCCESS) { nx_packet_release(data_packet); continue; }

        ret = nx_udp_socket_send(&UDPSocket, data_packet, UDP_SERVER_ADDRESS, TCP_SERVER_PORT);
        if (ret != NX_SUCCESS) { nx_packet_release(data_packet); continue; }

        HAL_GPIO_TogglePin(LED1_GPIO_Port, LED1_Pin);
        tx_thread_relinquish();
    }
}

/* ================================================================
 *  Remaining threads — unchanged
 * ================================================================ */
static VOID App_UDP_Server_Thread_Entry(ULONG thread_input)
{
    UINT          ret;
    NX_PACKET    *recv_packet;
    NX_PACKET    *fwd_packet;
    NX_UDP_SOCKET FwdSocket;
    UCHAR         recv_buffer[1472];
    ULONG         bytes_copied;
    ULONG         sender_ip;
    UINT          sender_port;

    ret = nx_udp_socket_create(&NetXDuoEthIpInstance, &UDPSocket, "UDP Server Socket",
                               NX_IP_NORMAL, NX_FRAGMENT_OKAY, NX_IP_TIME_TO_LIVE, 200);
    if (ret != NX_SUCCESS) Error_Handler();
    ret = nx_udp_socket_bind(&UDPSocket, DEFAULT_PORT, NX_WAIT_FOREVER);
    if (ret != NX_SUCCESS) Error_Handler();

    ret = nx_udp_socket_create(&NetXDuoEthIpInstance, &FwdSocket, "UDP Fwd Socket",
                               NX_IP_NORMAL, NX_FRAGMENT_OKAY, NX_IP_TIME_TO_LIVE, 200);
    if (ret != NX_SUCCESS) Error_Handler();
    ret = nx_udp_socket_bind(&FwdSocket, PC_PORT, NX_WAIT_FOREVER);
    if (ret != NX_SUCCESS) Error_Handler();

    printf("UDP Server started - Listening on port %u\n", DEFAULT_PORT);

    while (1)
    {
        ret = nx_udp_socket_receive(&UDPSocket, &recv_packet, NX_WAIT_FOREVER);
        if (ret != NX_SUCCESS) continue;

        nx_udp_source_extract(recv_packet, &sender_ip, &sender_port);
        TX_MEMSET(recv_buffer, '\0', sizeof(recv_buffer));
        ret = nx_packet_data_retrieve(recv_packet, recv_buffer, &bytes_copied);
        nx_packet_release(recv_packet);
        if (ret != NX_SUCCESS) continue;

        ret = nx_packet_allocate(&NxAppPool, &fwd_packet, NX_UDP_PACKET, TX_WAIT_FOREVER);
        if (ret != NX_SUCCESS) continue;

        ret = nx_packet_data_append(fwd_packet, recv_buffer, bytes_copied,
                                    &NxAppPool, TX_WAIT_FOREVER);
        if (ret != NX_SUCCESS) { nx_packet_release(fwd_packet); continue; }

        ret = nx_udp_socket_send(&FwdSocket, fwd_packet, PC_IP_ADDRESS, PC_PORT);
        if (ret != NX_SUCCESS) { nx_packet_release(fwd_packet); continue; }

        HAL_GPIO_TogglePin(LED1_GPIO_Port, LED1_Pin);
    }
}

static VOID App_TCP_Thread_Entry(ULONG thread_input)
{
    UINT ret;
    UINT count = 0;
    ULONG bytes_read;
    UCHAR data_buffer[512];
    ULONG source_ip_address;
    UINT  source_port;
    NX_PACKET *server_packet;
    NX_PACKET *data_packet;

    ret = nx_tcp_socket_create(&NetXDuoEthIpInstance, &TCPSocket,
                               "TCP Server Socket", NX_IP_NORMAL,
                               NX_FRAGMENT_OKAY, NX_IP_TIME_TO_LIVE,
                               WINDOW_SIZE, NX_NULL, NX_NULL);
    if (ret != NX_SUCCESS) Error_Handler();
    ret = nx_tcp_client_socket_bind(&TCPSocket, DEFAULT_PORT, NX_WAIT_FOREVER);
    if (ret != NX_SUCCESS) Error_Handler();
    ret = nx_tcp_client_socket_connect(&TCPSocket, UDP_SERVER_ADDRESS,
                                       TCP_SERVER_PORT, NX_WAIT_FOREVER);
    if (ret != NX_SUCCESS) Error_Handler();

    while (1)
    {
        TX_MEMSET(data_buffer, '\0', sizeof(data_buffer));
        ret = nx_packet_allocate(&NxAppPool, &data_packet, NX_TCP_PACKET, TX_WAIT_FOREVER);
        if (ret != NX_SUCCESS) break;
        ret = nx_packet_data_append(data_packet, (VOID *)DEFAULT_MESSAGE,
                                    sizeof(DEFAULT_MESSAGE), &NxAppPool, TX_WAIT_FOREVER);
        if (ret != NX_SUCCESS) { nx_packet_release(data_packet); break; }
        ret = nx_tcp_socket_send(&TCPSocket, data_packet, DEFAULT_TIMEOUT);
        if (ret != NX_SUCCESS) break;
        ret = nx_tcp_socket_receive(&TCPSocket, &server_packet, DEFAULT_TIMEOUT);
        if (ret == NX_SUCCESS)
        {
            nx_packet_data_retrieve(server_packet, data_buffer, &bytes_read);
            PRINT_DATA(source_ip_address, source_port, data_buffer);
            nx_packet_release(server_packet);
            HAL_GPIO_TogglePin(LED1_GPIO_Port, LED1_Pin);
        }
        else break;
    }
    nx_packet_release(server_packet);
    nx_tcp_socket_disconnect(&TCPSocket, DEFAULT_TIMEOUT);
    nx_tcp_client_socket_unbind(&TCPSocket);
    nx_tcp_socket_delete(&TCPSocket);
    if (count == MAX_PACKET_COUNT + 1) Success_Handler();
    else Error_Handler();
}

static VOID App_Link_Thread_Entry(ULONG thread_input)
{
    ULONG actual_status;
    UINT  linkdown = 0, status;
    printf("link thread started");

    while (1)
    {
        status = nx_ip_interface_status_check(&NetXDuoEthIpInstance, 0,
                                              NX_IP_LINK_ENABLED, &actual_status, 10);
        if (status == NX_SUCCESS)
        {
            if (linkdown == 1)
            {
                linkdown = 0;
                printf("The network cable is connected.\n");
                nx_ip_driver_direct_command(&NetXDuoEthIpInstance, NX_LINK_ENABLE, &actual_status);
                status = nx_ip_interface_status_check(&NetXDuoEthIpInstance, 0,
                                                      NX_IP_ADDRESS_RESOLVED, &actual_status, 10);
                if (status == NX_SUCCESS)
                {
                    nx_ip_address_set(&NetXDuoEthIpInstance, STM_IP_ADDRESS, STM_NETMASK);
                    nx_ip_gateway_address_set(&NetXDuoEthIpInstance, STM_GATEWAY);
                    printf("Link reconnected. Static IP reapplied.\n");
                    PRINT_IP_ADDRESS(IpAddress);
                }
            }
        }
        else
        {
            if (linkdown == 0)
            {
                linkdown = 1;
                printf("The network cable is not connected.\n");
                nx_ip_driver_direct_command(&NetXDuoEthIpInstance, NX_LINK_DISABLE, &actual_status);
            }
        }
        tx_thread_sleep(NX_APP_CABLE_CONNECTION_CHECK_PERIOD);
    }
}

