/* ── Shared result array — written by AppSensorThread, read by AppUDPThread ──
 *
 *  All fields are written atomically by the sensor thread.
 *  is_metal_latch is SET by the sensor thread and CLEARED by the UDP thread
 *  after it has been packed into an outgoing packet.
 *
 *  No RTOS mutex is used because:
 *    - 8/16/32-bit aligned writes on Cortex-M7 are atomic.
 *    - The sensor thread only ever SETS is_metal_latch (never clears it).
 *    - The UDP thread only ever CLEARS is_metal_latch (never sets it).
 *    - There is no harmful race: a missed set means the latch persists
 *      one more cycle; a missed clear means a one-cycle false positive —
 *      both are acceptable and vanishingly rare.
 */
typedef struct {
    uint16_t ldc;
    uint16_t rp;
    uint32_t freq_hz;
    int32_t  deviation;
    int32_t  threshold;
    int32_t  baseline;
    int32_t  raw_mean;
    int32_t  filt_std;
    uint8_t  is_metal_now;    /* current instantaneous state    */
    uint8_t  is_metal_latch;  /* stays 1 until UDP thread reads */
    uint8_t  calib_done;
} SensorResult_t;

volatile SensorResult_t sensorResults[LDC1101_SENSOR_COUNT];

