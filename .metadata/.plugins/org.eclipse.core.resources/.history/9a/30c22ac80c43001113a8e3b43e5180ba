/* ── Metal detection latch ───────────────────────────────────────────────────
 *  One byte per sensor.  Set to 1 inside build_ldc_packet() the moment
 *  Detector_Update returns true.  Cleared to 0 only after it has been
 *  copied into pkt->is_metal[i] and is about to be transmitted.
 *
 *  This is a static array (no extra stack allocation needed).
 * ─────────────────────────────────────────────────────────────────────────── */
static uint8_t is_metal_latch[LDC1101_SENSOR_COUNT];

