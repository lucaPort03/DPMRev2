/**
  ******************************************************************************
  * @file    app_netxduo.c
  * @brief   NetXDuo applicative file
  *
  *  Metal detection latch — how missed detections are fixed:
  *
  *  The previous two-thread approach failed because it required extra
  *  stack memory that the byte pool couldn't satisfy.
  *
  *  This version stays as a single thread but adds a SOFTWARE LATCH
  *  inside build_ldc_packet():
  *
  *    is_metal_latch[i] is set to 1 the instant Detector_Update
  *    returns true.  It is only cleared AFTER it has been packed into
  *    the outgoing packet.
  *
  *  This means: even if the metal spike lasts only 1–2 samples and
  *  resets before the packet is fully built, the latch preserves the
  *  detection state until the next UDP send.  Every detection event
  *  is guaranteed to appear in at least one transmitted packet.
  *
  *  No extra thread, no extra memory, no priority changes needed.
  * ******************************************************************************
  */
/* USER CODE END Header */

