#ifndef DETECTION_H
#define DETECTION_H

#include <stdbool.h>
#include <stdint.h>

#define CALIB_SAMPLES   60000u
#define THRESHOLD_K     6.0
/* ================================================================
 *  CONFIRM_SAMPLES
 *
 *  How many consecutive samples must exceed |threshold| before
 *  metal_det is set true.
 *
 *  Set to 1: triggers on the very first crossing — correct for
 *  1–3 sample spikes at high belt speeds. Raising this would
 *  reject real detections as noise at this sample rate.
 * ================================================================ */
#define CONFIRM_SAMPLES  1u

/* ================================================================
 *  HOLD_SAMPLES
 *
 *  Minimum number of samples metal_det stays TRUE after triggering,
 *  regardless of whether the deviation drops below threshold.
 *
 *  This prevents double-counting a single piece when the band-pass
 *  filter rings after the peak, or when the piece produces a
 *  two-lobe signal as it enters and exits the coil field.
 *
 *  At your measured ~20 Hz packet rate and 1.6 m/s belt speed:
 *    A piece takes roughly 10–50 ms to cross a sensor
 *    = 0.2 – 1 sample at 20 Hz
 *
 *  Set HOLD_SAMPLES to cover the full expected crossing time plus
 *  a margin. Starting value: 5 samples (~250 ms at 20 Hz).
 *
 *  If you still see double-counts → raise it (try 8, 10).
 *  If fast successive pieces are being merged → lower it (try 3).
 * ================================================================ */
#define HOLD_SAMPLES     20u

/* ================================================================
 *  RELEASE_RATIO
 *
 *  metal_det clears only when |deviation| drops below:
 *      threshold * RELEASE_RATIO
 *
 *  Prevents rapid on/off flickering when the deviation hovers
 *  near the threshold boundary on the trailing edge of a piece.
 *  0.5 = signal must fall to half the trigger level to release.
 * ================================================================ */
#define RELEASE_RATIO    0.5

typedef struct {

    /* ── Band-pass filter delay registers ── */
    double x1, x2;
    double y1, y2;
    double y_bpfilt;

    /* ── Calibration accumulators (Welford algorithm) ── */
    uint32_t calib_count;
    bool     calib_done;

    /* Welford state for the RAW frequency */
    double raw_mean;
    double raw_M2;

    /* Welford state for the FILTERED signal */
    double filt_mean;
    double filt_M2;
    double filt_std;

    /* ── Frozen detection parameters ── */
    double baseline;
    double threshold;

    /* ── Runtime outputs ── */
    double   deviation;       /* signed BP filter output            */
    double   abs_deviation;   /* |deviation| — used for detection   */
    bool     metal_det;

    /* Internal confirmation counter */
    uint32_t confirm_count;

    /* Hold counter: counts down after metal_det goes true.
     * While > 0, metal_det cannot go false and re-trigger. */
    uint32_t hold_count;

} DetectorState;

/* ── Public API ── */
void Detector_Init     (DetectorState *s);
bool Detector_Update   (DetectorState *s, double x_raw_hz);
bool Detector_CalibDone(const DetectorState *s);

#endif /* DETECTION_H */
